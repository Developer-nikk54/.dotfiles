

window-decoration = none
# theme = Adwaita Dark
theme = noctalia
# background-opacity = 0.45
foreground = #BFC9D1
font-size = 15
# font-family = FiraCode Nerd Font
font-family = JetBrains Mono Nerd Font
# font-style = semibold
bold-color = bright
font-thicken = true
font-thicken-strength = 0
font-feature = liga, calt, kern
adjust-cell-height = 5%
bell-features = no-audio
tab-inherit-working-directory = true
split-inherit-working-directory = true
split-divider-color = #b8bb26
window-inherit-working-directory = true
window-show-tab-bar = never
window-padding-y = 0
window-padding-x = 15
window-height = 33
window-width = 131
window-padding-color = extend
title = "Ghostty - Ghostty"
shell-integration-features = cursor
cursor-color = #d4d4d4
cursor-style = bar
mouse-hide-while-typing = true
selection-background = #626881
confirm-close-surface = false
# selection-background = #FF70BF

# ------------------ keybinds ------------------
keybind = ctrl+shift+;=toggle_tab_overview
keybind = ctrl+shift+|=new_split:right
keybind = ctrl+shift+-=new_split:down
keybind = ctrl+shift+h=goto_split:left
keybind = ctrl+shift+j=goto_split:down
keybind = ctrl+shift+k=goto_split:up
keybind = ctrl+shift+l=goto_split:right

# custom-shader = shaders/in-game-crt.glsl

# my fevourite shader

# custom-shader = shaders/cursor_blaze.glsl
custom-shader = shaders/in-game-crt-cursor.glsl
custom-shader = shaders/cursor_smear.glsl
# custom-shader = shaders/tft.glsl
