

window-decoration = none
window-show-tab-bar = never
# theme = Adwaita Dark
theme = noctalia
# background-opacity = 0.45
foreground = #BFC9D1
font-size = 15
# font-family = FiraCode Nerd Font
font-family = JetBrains Mono Nerd Font
# font-style = semibold
bold-color = bright
font-thicken = true
font-thicken-strength = 0
font-feature = liga, calt, kern
adjust-cell-height = 5%
bell-features = no-audio
window-inherit-working-directory = true
tab-inherit-working-directory = true
split-inherit-working-directory = true
window-padding-y = 0
window-padding-x = 15
window-height = 33
window-width = 131
window-padding-color = extend
title = "Ghostty - Ghostty"
shell-integration-features = cursor
cursor-color = #d4d4d4
selection-background = #626881
cursor-style = bar
confirm-close-surface = false
# selection-background = #FF70BF



# custom-shader = shaders/in-game-crt.glsl

# my fevourite shader

# custom-shader = shaders/cursor_blaze.glsl
custom-shader = shaders/in-game-crt-cursor.glsl
custom-shader = shaders/cursor_smear.glsl
# custom-shader = shaders/tft.glsl
